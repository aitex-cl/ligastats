[Unit]
Description=LigaStats - panel web (127.0.0.1:8011)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ligastats
Group=ligastats
Slice=ligastats.slice
WorkingDirectory=/opt/ligastats/current
EnvironmentFile=/opt/ligastats/shared/config.env
Environment=LIGASTATS_HOME=/opt/ligastats/current
Environment=PYTHONUNBUFFERED=1
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ligastats/shared
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ExecStart=/opt/ligastats/venv/bin/python -m ligastats.web
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
