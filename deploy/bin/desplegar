#!/usr/bin/env bash
# =============================================================================
#  LigaStats - punto de entrada de los despliegues automáticos (GitHub Actions)
#
#  Lo ejecuta el usuario 'despliegue' por SSH con comando forzado + sudo:
#     <commit de 40 caracteres>   recibe el código (tar.gz por stdin) e instala
#     rollback                    vuelve a la versión anterior
#     estado                      muestra el estado
#  Cualquier otro argumento se rechaza.
# =============================================================================
set -euo pipefail
ARG="${1:-}"
BASE=/opt/ligastats
LOG="$BASE/shared/logs/despliegues.log"
mkdir -p "$(dirname "$LOG")"
exec 9>/run/ligastats-despliegue.lock
flock -n 9 || { echo "Hay otro despliegue en curso"; exit 1; }
echo "=== $(date -Is) despliegue: ${ARG:-<vacío>}" | tee -a "$LOG"

case "$ARG" in
    rollback)
        bash "$BASE/current/instalar.sh" --rollback 2>&1 | tee -a "$LOG" ;;
    estado)
        bash "$BASE/current/instalar.sh" --estado 2>&1 | tee -a "$LOG" ;;
    *)
        [[ "$ARG" =~ ^[0-9a-f]{40}$ ]] || { echo "Argumento no permitido" | tee -a "$LOG"; exit 2; }
        tmp="$(mktemp -d /tmp/ligastats-despliegue-XXXXXX)"
        trap 'rm -rf "$tmp"' EXIT
        head -c 52428800 | tar -xz -C "$tmp" --no-same-owner
        [[ -f "$tmp/instalar.sh" && -d "$tmp/ligastats" && -f "$tmp/requirements.txt" ]] \
            || { echo "Paquete incompleto" | tee -a "$LOG"; exit 3; }
        echo "$ARG" > "$tmp/VERSION_COMMIT"
        cd "$tmp"
        bash instalar.sh 2>&1 | tee -a "$LOG"
        ;;
esac
